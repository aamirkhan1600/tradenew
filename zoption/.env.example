# zoption — copy to .env and fill in.

NODE_ENV=development
PORT=4100
APP_URL=http://localhost:4100

# 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# At least 32 characters.
JWT_SECRET=a1d684e3dea9da9ba209317a38325335a822d6e90f84c9e2d1e3f96d565a05c2f9762d5b90ce90aee9ecaa349bb3320e
JWT_EXPIRES_IN=12h

# Only outside production. A prod deployment serving session cookies over
# plain HTTP is a defect, not a preference.
ALLOW_INSECURE_COOKIES=true

# Global kill switch. When true the engine manages and exits existing
# positions but opens nothing new.
TRADING_HALTED=false

# --- database -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zoption
DB_CONNECTION_LIMIT=10

# --- Kotak Neo ----------------------------------------------------------
# From NEO App -> Invest -> Trade API -> Your Applications.
# Used raw in the Authorization header — no "Bearer" scheme.
NEO_API_TOKEN=b431d95b-9f27-4fa9-8d23-58467b9d4a0d
NEO_API_BASE=https://gw-napi.kotaksecurities.com
NEO_LOGIN_URL=https://mis.kotaksecurities.com
NEO_FIN_KEY=neotradeapi
NEO_RPS=8

# Market data. The REST quote poll is not a fallback that switches on after a
# timeout — Kotak's HSM socket accepts subscribes and then streams nothing on
# many accounts, so it always runs alongside the socket. 0 disables it.
NEO_WS_URL=wss://mlhsm.kotaksecurities.com/realtime
NEO_POLL_MS=1000
NEO_QUOTE_BATCH=25
NEO_MAX_SYMBOLS=250
NEO_DEFAULT_SEGMENT=nse_fo

# --- engine -------------------------------------------------------------
ENGINE_TICK_MS=1000
ENGINE_ID=
ENGINE_LOCK_TTL_MS=30000
ORDER_CONFIRM_TIMEOUT_MS=15000
ORDER_CONFIRM_POLL_MS=750

# A bar built from fewer ticks than this is low-confidence and will not
# trigger an entry. 0 accepts any bar that saw at least one tick.
CANDLE_MIN_TICKS=2

# --- charges (NSE F&O options; the contract note remains authoritative) --
CHG_BROKERAGE_PER_ORDER=0
CHG_STT_SELL_PCT=0.1
CHG_EXCH_TXN_PCT=0.03503
CHG_SEBI_PCT=0.0001
CHG_GST_PCT=18
CHG_STAMP_BUY_PCT=0.003

# --- trading terminal ---------------------------------------------------
# The read-only chart / option chain / premium terminal at /terminal. It runs
# in the WEB process and opens a SECOND market-data socket and quote poller
# against the same Kotak account as the engine. Kotak's rate limit is per
# account and the two processes hold separate token buckets, so these requests
# ADD to the engine's — at the defaults, about 3 of the 8 per second.
#
# Nothing here runs until a browser opens /terminal, and it all stops again
# about 45 seconds after the last one closes.
TERMINAL_CHAIN_MS=1000
TERMINAL_STRIKE_RANGE=10
TERMINAL_MAX_RANGE=20
# Greeks and IV are MODELLED here — Kotak sends none — so this is the rate the
# Black-Scholes solve uses, in percent.
TERMINAL_RISK_FREE_RATE=6.5
# India VIX is quoted by name rather than by token; turn this off if the
# gateway refuses it.
TERMINAL_VIX=true

# --- retention ----------------------------------------------------------
EVENT_RETENTION_DAYS=30
CANDLE_RETENTION_DAYS=14
