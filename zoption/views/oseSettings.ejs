<%- include('partials/head', { title: 'zoption — option selling settings' }) %>
<%- include('partials/nav', { page: page }) %>

<main class="wrap">

  <% if (error) { %>
    <section class="card warnbox">
      <h2 class="down">Not saved</h2>
      <p class="msg bad"><%= error %></p>
    </section>
  <% } %>
  <% if (saved) { %>
    <section class="card"><p class="msg ok"><%= saved %></p></section>
  <% } %>

  <% if (warnings && warnings.length) { %>
    <section class="card warnbox">
      <h2>Worth a look <small>legal settings that are probably not what you meant</small></h2>
      <ul><% warnings.forEach(function (w) { %><li><%= w %></li><% }); %></ul>
    </section>
  <% } %>

  <!-- §17.3.1. Charges are per ROUND TRIP and dominated by a flat brokerage, so
       a one-point target can be a guaranteed loss before the market is consulted
       at all. Shown before any of the inputs, deliberately. -->
  <section class="card">
    <h2>What this configuration needs to break even
      <small>charges are paid in full on winners and losers alike</small></h2>
    <dl class="kv">
      <dt>Quantity</dt><dd><%= note.qty %> (<%= settings.lots %> lot)</dd>
      <dt>Round-trip charges</dt><dd><%= money.formatInr(note.chargesP) %></dd>
      <dt>Break-even move</dt><dd>₹<%= (note.breakevenPointsP / 100).toFixed(2) %> of premium</dd>
      <dt>First rung (<%= settings.initialTargetPoints %> pt)</dt>
      <dd>
        <% if (note.requiredWinRate === null) { %>
          <span class="down">a win loses money at this size</span>
        <% } else { %>
          needs a <b class="<%= note.requiredWinRate >= 0.6 ? 'down' : '' %>"><%= (note.requiredWinRate * 100).toFixed(0) %>%</b>
          win rate · win <%= money.formatInr(note.winP) %>, loss <%= money.formatInr(note.lossP) %>
        <% } %>
      </dd>
    </dl>
  </section>

  <form class="card" method="post" action="/ose/settings">

    <h2>Contract <small>§5.1 — the engine snapshots these when it selects a strike</small></h2>
    <div class="grid">
      <label>Premium minimum ₹
        <input name="premiumMin" type="number" step="0.05" value="<%= settings.premiumMin %>">
      </label>
      <label>Premium maximum ₹
        <input name="premiumMax" type="number" step="0.05" value="<%= settings.premiumMax %>">
      </label>
      <label>Entry offset ₹ <span class="hint">added to the sealed close</span>
        <input name="entryOffset" type="number" step="0.05" value="<%= settings.entryOffset %>">
      </label>
      <label>Lots <span class="hint">[MUST-CONFIRM #2]</span>
        <input name="lots" type="number" step="1" min="1" value="<%= settings.lots %>">
      </label>
      <label>Execution
        <select name="mode">
          <option value="PAPER" <%= settings.mode === 'PAPER' ? 'selected' : '' %>>PAPER — simulated, nothing reaches the exchange</option>
          <option value="LIVE"  <%= settings.mode === 'LIVE'  ? 'selected' : '' %>>LIVE — orders reach the exchange</option>
        </select>
      </label>
    </div>

    <h2>Target and stop <small>§14, §15 — premium points, never index points</small></h2>
    <div class="grid">
      <label>Initial target (points) <span class="hint">one rung of the ladder</span>
        <input name="initialTargetPoints" type="number" step="0.05" min="0.05" value="<%= settings.initialTargetPoints %>">
      </label>
      <label>Initial stop (points)
        <input name="initialStopPoints" type="number" step="1" min="1" value="<%= settings.initialStopPoints %>">
      </label>
      <label>Target extension (points)
        <input name="targetExtensionPoints" type="number" step="1" min="1" value="<%= settings.targetExtensionPoints %>">
      </label>
      <label>Premium safety exit (points)
        <input name="premiumSafetyExitPoints" type="number" step="1" min="1" value="<%= settings.premiumSafetyExitPoints %>">
      </label>
      <label>Trailing stop <span class="hint">§15.5</span>
        <select name="trailingStopEnabled">
          <option value="true"  <%= settings.trailingStopEnabled ? 'selected' : '' %>>ON — tighten the stop on every rung</option>
          <option value="false" <%= settings.trailingStopEnabled ? '' : 'selected' %>>OFF — the stop stays at entry + initial</option>
        </select>
      </label>
      <!-- §16.4. The stop is otherwise evaluated once per 5s candle on a SAMPLED
           high, so a spike between two polls leaves no trace in the candle and
           does not fire it at all. -->
      <label>Sampled-stop guard <span class="hint">[MUST-CONFIRM #12]</span>
        <select name="stopGuardEnabled">
          <option value="true"  <%= settings.stopGuardEnabled ? 'selected' : '' %>>ON — re-check the live sample every second</option>
          <option value="false" <%= settings.stopGuardEnabled ? '' : 'selected' %>>OFF — the 5s candle high only</option>
        </select>
      </label>
    </div>

    <!-- newdoc/ema.md — the EMA Trend Confirmation Engine. It runs BEFORE the
         3-candle trend engine and can only ever refuse; nothing here selects a
         strike or prices an order. -->
    <h2>EMA trend filter <small>newdoc/ema.md — EMA 9 / EMA 20 on the 5s NIFTY candle</small></h2>
    <div class="grid">
      <label>EMA filter <span class="hint">ema.md calls it mandatory</span>
        <select name="emaFilterEnabled">
          <option value="true"  <%= settings.emaFilterEnabled ? 'selected' : '' %>>ON — an entry needs EMA confirmation first</option>
          <option value="false" <%= settings.emaFilterEnabled ? '' : 'selected' %>>OFF — the 3-candle trend and midpoint alone</option>
        </select>
      </label>
      <label>Crossover exit <span class="hint">§Position Exit Rule</span>
        <select name="emaExitOnCrossover">
          <option value="true"  <%= settings.emaExitOnCrossover ? 'selected' : '' %>>ON — close when EMA9 crosses back through EMA20</option>
          <option value="false" <%= settings.emaExitOnCrossover ? '' : 'selected' %>>OFF — leave it to the trend break and the stop</option>
        </select>
      </label>
      <label>Flat band (index points) <span class="hint">[MUST-CONFIRM #18]</span>
        <input name="emaFlatPoints" type="number" step="0.05" min="0" value="<%= settings.emaFlatPoints %>">
      </label>
      <label>Crossover cooldown (candles)
        <input name="emaCrossCooldownCandles" type="number" step="1" min="0" value="<%= settings.emaCrossCooldownCandles %>">
      </label>
      <label>Chop window (candles)
        <input name="emaChopLookback" type="number" step="1" min="0" value="<%= settings.emaChopLookback %>">
      </label>
      <label>Chop crossings <span class="hint">of EMA9, inside that window</span>
        <input name="emaChopFlips" type="number" step="1" min="0" value="<%= settings.emaChopFlips %>">
      </label>
    </div>
    <p class="hint">
      An entry needs <b>EMA9 &gt; EMA20 and the close above EMA9</b> to sell a PE, and the mirror
      image to sell a CE — <i>and</i> the 3-candle trend engine has to agree. The three numbers
      above are the market states the document rules out in words and gives no value for: the
      averages being <b>indistinguishable</b> (flat band), the crossover being <b>too recent</b> to
      trust, and price <b>crossing EMA9 repeatedly</b> inside a short window. Widen any of them and
      the engine trades less; the <code>EMA_SIDEWAYS</code> tally on
      <a href="/ose">the engine page</a> is the direct measure of what they cost today.
    </p>
    <p class="hint">
      EMA20 first exists on the 20th completed candle and the crossover test needs the one before
      it, so <b>no entry is possible for the first 21 candles</b> — about 105 seconds — after the
      process starts or the feed comes back. The decision log reads
      <code>EMA_WARMING_UP</code> throughout, and that is the filter working rather than a stalled
      feed.
    </p>

    <!-- The index-feed sanity check. Added after this account's gateway answered
         `nse_cm|Nifty 50` with 25117.55 while the index was at 24383.60 — a
         734-point error served with a 200 and no error anywhere. -->
    <h2>Index feed check <small>does the index agree with the chain it is trading?</small></h2>
    <div class="grid">
      <label>Feed check
        <select name="spotCheckEnabled">
          <option value="true"  <%= settings.spotCheckEnabled ? 'selected' : '' %>>ON — refuse to select a strike when they disagree</option>
          <option value="false" <%= settings.spotCheckEnabled ? '' : 'selected' %>>OFF — trust the index feed</option>
        </select>
      </label>
      <label>Max divergence (index points)
        <input name="spotCheckMaxDivergencePoints" type="number" step="5" min="1" value="<%= settings.spotCheckMaxDivergencePoints %>">
      </label>
      <label>Minimum strike pairs <span class="hint">quoting both CE and PE</span>
        <input name="spotCheckMinPairs" type="number" step="1" min="1" value="<%= settings.spotCheckMinPairs %>">
      </label>
    </div>
    <p class="hint">
      Every strike that quotes <b>both</b> legs is an independent reading of the index:
      put-call parity gives <code>spot ≈ strike + (CE − PE)</code>. The engine takes the
      <b>median</b> across the chain and compares it against the sealed index candle. Because that
      second opinion moves <i>with</i> the market, a violent day does not trip it — only a feed
      describing a different market does.
      <b>On 2026-08-02 this account's index feed read 25117.55 while 41 strikes priced it at
      24381.85.</b> At that spot the at-the-money strike computes as 25100 instead of 24400, so
      every CE in the sellable band is marked in-the-money and refused. Nothing in the system
      noticed until this check existed.
    </p>
    <p class="hint">
      A disagreement blocks <b>new entries only</b> — an open position is still managed, because its
      stop, target and premium floor are read from the option contract's own candle. The §13.3
      position-validity filter <i>is</i> affected, so if you see <code>SPOT_DIVERGENCE</code> with a
      position open, square off from the Kotak terminal rather than waiting.
    </p>

    <!-- The synthetic index. Added after this account's gateway served a
         734-point-stale index for a whole session while its option quotes stayed
         current to within ten points. -->
    <h2>Synthetic index <small>the index, derived from the chain when the feed is wrong</small></h2>
    <div class="grid">
      <label>When the feed disagrees
        <select name="syntheticIndexMode">
          <option value="AUTO"  <%= settings.syntheticIndexMode === 'AUTO'  ? 'selected' : '' %>>AUTO — derive the index from the chain until the feed agrees again</option>
          <option value="OFF"   <%= settings.syntheticIndexMode === 'OFF'   ? 'selected' : '' %>>OFF — never derive; the engine simply stops entering</option>
          <option value="FORCE" <%= settings.syntheticIndexMode === 'FORCE' ? 'selected' : '' %>>FORCE — always derive, even from a healthy feed (proving only)</option>
        </select>
      </label>
      <label>Strikes to derive from <span class="hint">both legs of each</span>
        <input name="syntheticIndexStrikes" type="number" step="1" min="3" max="10" value="<%= settings.syntheticIndexStrikes %>">
      </label>
    </div>
    <p class="hint">
      Every strike that quotes <b>both</b> legs prices the index by put-call parity, and the
      median across them is a level derived from the instruments the engine actually trades. The
      legs ride in the <b>same one-second poll</b> the index and the held contract already use, so
      this costs no extra request. Measured live on 2026-08-02 against a feed that was 734 points
      wrong, six strikes returned <b>24384.10</b> against a true 24383.60 — and did so with the
      window centred on the <i>wrong</i> spot, because parity holds at every strike.
    </p>
    <p class="hint">
      <b>A source change throws the candle buffer away.</b> The two sources were 734 points apart,
      and splicing one series onto the other would put a 734-point step in the middle of it that
      the trend engine and the EMA would both read as a real move. So the buffer is cleared and
      the averages re-warm — about <b>105 seconds of no entries</b> at every switch, in each
      direction. The decision log records <code>index_source</code> on every row.
    </p>

    <h2>Selection <small>§9 — and what this Kotak account can actually filter on</small></h2>
    <div class="grid">
      <label>Liquidity mode <span class="hint">[MUST-CONFIRM #13]</span>
        <select name="liquidityMode">
          <option value="STRICT"  <%= settings.liquidityMode === 'STRICT'  ? 'selected' : '' %>>STRICT — a field the broker omits is a FAILURE</option>
          <option value="LENIENT" <%= settings.liquidityMode === 'LENIENT' ? 'selected' : '' %>>LENIENT — skip it, and record that it was skipped</option>
        </select>
      </label>
      <label>Scan range <span class="hint">strikes either side of ATM</span>
        <input name="scanRange" type="number" step="1" min="1" max="40" value="<%= settings.scanRange %>">
      </label>
      <label>Trade on expiry day <span class="hint">[MUST-CONFIRM #7]</span>
        <select name="tradeOnExpiryDay">
          <option value="true"  <%= settings.tradeOnExpiryDay ? 'selected' : '' %>>ON</option>
          <option value="false" <%= settings.tradeOnExpiryDay ? '' : 'selected' %>>OFF</option>
        </select>
      </label>
    </div>
    <p class="hint">
      This account answers the <code>ltp</code> quote filter and nothing else, so open interest,
      volume and the bid/ask spread never arrive. STRICT therefore selects <b>no strike at all</b>
      — the correct behaviour of a required filter with nothing to filter on, and visible rather
      than silent. Re-check with <code>node scripts/diagnose-spot.js</code>.
    </p>

    <h2>Candle quality <small>§7.8 — [MUST-CONFIRM #11]</small></h2>
    <div class="grid">
      <label>Index minimum samples
        <input name="indexMinTicks" type="number" step="1" min="0" value="<%= settings.indexMinTicks %>">
      </label>
      <label>Option minimum samples
        <input name="optionMinTicks" type="number" step="1" min="0" value="<%= settings.optionMinTicks %>">
      </label>
    </div>
    <p class="hint">
      A 5-second bar is built from REST quote samples — at most five, often one or two. A bar
      holding fewer than this may not price an order. Too high and the engine never trades; too
      low and it prices from a close that predates the bucket by most of its width.
    </p>

    <h2>Risk <small>§17</small></h2>
    <div class="grid">
      <label>Maximum trades per day
        <input name="maxTradesPerDay" type="number" step="1" min="1" value="<%= settings.maxTradesPerDay %>">
      </label>
      <label>Maximum consecutive losses <span class="hint">trips a HALT</span>
        <input name="maxConsecutiveLosses" type="number" step="1" min="1" value="<%= settings.maxConsecutiveLosses %>">
      </label>
      <label>Re-entry wait (candles)
        <input name="reentryWaitCandles" type="number" step="1" min="0" value="<%= settings.reentryWaitCandles %>">
      </label>
      <div class="actions">
        <button type="submit" class="go">Save</button>
        <a class="link" href="/ose">Back to the engine</a>
        <span class="hint">
          The engine reads settings at cycle start, never mid-cycle — a save takes effect on the
          next candle, and an open position keeps the numbers it was opened with.
        </span>
      </div>
    </div>
  </form>

  <!-- §22. The engine ENFORCES this list rather than merely stating it:
       settings.load() refuses LIVE while any id is missing.

       A SEPARATE form from the settings above, on purpose. It posts only the
       sign-off boxes, so every other key arrives absent and keeps its stored
       value — and `coerce` rebuilds `confirmed` from whatever is ticked, which
       is what makes withdrawing a sign-off possible at all. -->
  <form class="card" method="post" action="/ose/settings">
    <h2>Specification sign-off
      <small>§22 — LIVE mode refuses to start while any of these is unsigned</small></h2>
    <p class="hint">
      <b><%= unsigned.length %> of <%= mustConfirm.length %></b> unsigned. Ticking a box records
      that the trading desk has agreed that item; clearing one withdraws it, because a sign-off
      must be reversible when a rule changes underneath it.
    </p>
    <!-- Marks this form as the OWNER of the §22 register. Without it, a save
         from the settings form above would arrive with no boxes ticked and
         withdraw every sign-off as a side effect. -->
    <input type="hidden" name="confirm_form" value="1">
    <div class="tablewrap">
      <table class="events signoff">
        <thead>
          <tr><th>Signed</th><th>#</th><th>§</th><th>Item</th><th>Shipped answer</th></tr>
        </thead>
        <tbody>
          <% mustConfirm.forEach(function (m) { %>
            <tr class="<%= unsigned.indexOf(m.id) === -1 ? 'signed' : 'unsigned' %>">
              <td><input type="checkbox" name="confirm_<%= m.id %>" value="true"
                         <%= unsigned.indexOf(m.id) === -1 ? 'checked' : '' %>></td>
              <td class="num">#<%= m.id %></td>
              <td class="num"><%= m.section %></td>
              <td>
                <%= m.item %>
                <% if (m.note) { %><div class="hint"><%= m.note %></div><% } %>
              </td>
              <td class="muted"><%= m.proposed %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="actions">
      <button type="submit" class="go">Save sign-offs</button>
    </div>
  </form>

</main>

<%- include('partials/foot') %>
