# ---------------------------------------------------------------------------
# Premium Range Trader — environment
# Copy to .env and fill in. `npm run migrate` validates the DB settings.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Cookies are Secure (HTTPS-only) by default. For local HTTP dev you must opt
# out explicitly or the login cookie is never set. NEVER true in production.
ALLOW_INSECURE_COOKIES=true

# --- Database (MySQL / MariaDB, InnoDB) ------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=premium_range_trader
DB_CONNECTION_LIMIT=10

# --- Secrets ---------------------------------------------------------------
# 64+ random chars. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# EXACTLY 64 hex chars (32 bytes) — AES-256-GCM key for broker tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# --- Global kill switch ----------------------------------------------------
# true halts all NEW/opening orders. Exits and square-offs always pass.
TRADING_HALTED=false

# --- Zerodha Kite Connect (MARKET DATA ONLY) -------------------------------
# https://developers.kite.trade — the access token expires ~06:00 IST daily,
# so /brokers requires one login per trading day.
KITE_API_KEY=
KITE_API_SECRET=
KITE_API_BASE=https://api.kite.trade
KITE_WS_URL=wss://ws.kite.trade
KITE_LOGIN_URL=https://kite.zerodha.com/connect/login
# REST /quote/ltp top-up cadence for strikes that are not ticking.
KITE_POLL_MS=1000
# Ticker subscription cap per feed (Kite allows ~3000).
KITE_MAX_SYMBOLS=500

# --- Kotak Neo (EXECUTION ONLY) --------------------------------------------
# Plain access token from NEO App -> Invest -> Trade API -> Your Applications.
# Sent as-is in the Authorization header (no "Bearer" prefix).
NEO_API_TOKEN=
NEO_API_BASE=https://gw-napi.kotaksecurities.com
NEO_LOGIN_URL=https://mis.kotaksecurities.com
NEO_FIN_KEY=neotradeapi
# Requests per second per user against the Neo gateway.
NEO_RPS=8

# --- Engine ----------------------------------------------------------------
# Strategy evaluation cadence (ms). The feed is push-based; this is the rate at
# which the state machine is asked to decide.
ENGINE_TICK_MS=1000
# Identity of this engine process in the leader lock. Leave blank to auto-name.
ENGINE_ID=
# How long a leader lock survives without a heartbeat before another engine
# may take over. Must exceed ENGINE_TICK_MS by a wide margin.
ENGINE_LOCK_TTL_MS=30000
# How long to wait for an order to reach a terminal state before giving up.
ORDER_CONFIRM_TIMEOUT_MS=15000
ORDER_CONFIRM_POLL_MS=750

# --- Charges (NSE F&O options; used for breakeven + net P&L) ---------------
CHG_BROKERAGE_PER_ORDER=20
CHG_STT_SELL_PCT=0.1
CHG_EXCH_TXN_PCT=0.03503
CHG_SEBI_PCT=0.0001
CHG_GST_PCT=18
CHG_STAMP_BUY_PCT=0.003

# --- Retention -------------------------------------------------------------
EVENT_RETENTION_DAYS=30
TICK_RETENTION_DAYS=7
